{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClickyAI",
  "version": "0.1.0",
  "identifier": "com.samash.tauri-app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "ClickyAI Guide",
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "control",
        "url": "control.html",
        "title": "ClickyAI Settings",
        "width": 440,
        "height": 580,
        "resizable": true,
        "visible": false
      },
      {
        "label": "indicator",
        "url": "indicator.html",
        "title": "ClickyAI Status",
        "width": 340,
        "height": 96,
        "minWidth": 340,
        "maxWidth": 340,
        "minHeight": 96,
        "maxHeight": 96,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../omni_server/main.py": "perception/main.py",
      "../voice/worker.py": "voice/worker.py",
      "../voice/portal.py": "voice/portal.py",
      "../voice/local_tts.py": "voice/local_tts.py",
      "../desktop/hyprland_overlay.py": "desktop/hyprland_overlay.py",
      "../desktop/hyprland_status.py": "desktop/hyprland_status.py"
    }
  }
}
